/*
 * Elash Velvet keymap adapted from Sofle PLUS2 LAST_1002.vil
 * Source mapping: 6 keys per half in the four main rows; source encoder directions ignored.
 * The three central trackball click keys retain Velvet's default right/middle/left-click behavior.
 *
 * Known Vial-only features that need separate reimplementation are documented in KEYMAP_MIGRATION_NOTES.md.
 */

#define BASE 0
#define NUM 1
#define FN 2
#define GAME 3
#define EXTRA 4
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/ {
    behaviors {
        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp Q>, <&kp LS(Q)>;
        };

        td_t_mouse: td_t_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_T_MOUSE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp T>, <&mkp MCLK>;
        };

        td_semi: td_semi {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SEMI";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&kp LS(SEMI)>;
        };

        aholdtap: aholdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "AHOLDTAP";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <230>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            flavor = "tap-preferred";
        };

        holdtap: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <150>;
        };

        shift_c: shift_c {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_C";
            bindings = <&kp C>, <&kp LC(LS(C))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shift_v: shift_v {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_V";
            bindings = <&kp V>, <&kp LS(LC(V))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shift_F: shift_F {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_F";
            bindings = <&kp F>, <&kp LS(LC(F))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        ALT_E: ALT_E {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_E";
            bindings = <&kp E>, <&kp LA(LC(END))>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        ALT_R: ALT_R {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_R";
            bindings = <&kp R>, <&kp LS(LA(G))>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        ALT_T: ALT_T {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_T";
            bindings = <&kp T>, <&kp LC(LS(F10))>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        SHIFT_D: SHIFT_D {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_D";
            bindings = <&kp D>, <&kp LC(LS(A))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        CTRL_W: CTRL_W {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_W";
            bindings = <&kp W>, <&kp LS(LC(S))>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        SHIFT_Z: SHIFT_Z {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_Z";
            bindings = <&kp Z>, <&kp LS(LC(F10))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        ALT_X: ALT_X {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_X";
            bindings = <&kp X>, <&kp LS(LA(LC(N)))>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ctrl_x_sd {
            bindings = <&kp LC(X)>;
            key-positions = <27 28>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_ctrl_c_df {
            bindings = <&kp LC(C)>;
            key-positions = <28 29>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_ctrl_v_fg {
            bindings = <&kp LC(V)>;
            key-positions = <29 30>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_ctrl_z_sf {
            bindings = <&kp LC(Z)>;
            key-positions = <27 29>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_esc_tr {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_tab_re {
            bindings = <&kp TAB>;
            key-positions = <15 16>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_shift_w_we {
            bindings = <&kp LS(W)>;
            key-positions = <14 15>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_shift_q_qs {
            bindings = <&kp LS(Q)>;
            key-positions = <27 39>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_bspc_xc {
            bindings = <&kp BSPC>;
            key-positions = <41 42>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        combo_ctrl_c_f6cf {
            bindings = <&kp LC(C)>;
            key-positions = <28 29>;
            layers = <FN>;
            timeout-ms = <50>;
        };

        combo_ctrl_v_cfcg {
            bindings = <&kp LC(V)>;
            key-positions = <29 30>;
            layers = <FN>;
            timeout-ms = <50>;
        };

        combo_ctrl_x_f5f6 {
            bindings = <&kp LC(X)>;
            key-positions = <27 28>;
            layers = <FN>;
            timeout-ms = <50>;
        };

        combo_ctrl_z_f5cf {
            bindings = <&kp LC(Z)>;
            key-positions = <27 29>;
            layers = <FN>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            label = "BASE";
            bindings = <
&aholdtap LS(SEMI) SEMI  &aholdtap LS(APOS) APOS  &holdtap FSLH TILDE  &kp ESC   &kp LS(N9)   &kp LS(N0)              &kp HOME     &kp END      &kp PAGE_UP    &kp PAGE_DOWN  &kp BSLH  &kp LGUI
&kp CAPS                 &kp B                    &CTRL_W              &ALT_E    &ALT_R       &ALT_T       &mkp RCLK  &kp Y        &kp U        &kp I          &kp O          &kp SQT   &kp LBKT
&kp RALT                 &holdtap LEFT_ALT A      &mt LSHFT S          &kp D     &kp F        &mt LCTRL G  &mkp MCLK  &kp H        &kp J        &kp K          &kp L          &kp P     &kp RBKT
&kp DEL                  &aholdtap LS(Q) Q        &SHIFT_Z             &ALT_X    &shift_c     &shift_v     &mkp LCLK  &kp B        &kp N        &kp M          &kp COMMA      &kp DOT   &kp LS(FSLH)
                         &kp RCTRL                &kp LALT             &kp BSPC  &lt 2 SPACE  &lt 1 ENTER             &lt 1 ENTER  &lt 2 SPACE  &kp BACKSPACE  &tog 1         &tog 3
            >;
        };

        NUM {
            label = "NUM";
            bindings = <
&trans     &trans     &trans                     &trans                     &trans                     &trans                    &trans             &trans            &trans          &trans              &trans   &trans
&kp LC(N)  &kp COMMA  &aholdtap LS(N7) N7        &aholdtap LS(N8) N8        &aholdtap LS(N9) N9        &kp EQUAL      &mkp RCLK  &kp LC(PAGE_UP)    &kp LC(UP_ARROW)  &kp UP_ARROW    &kp LC(DOWN_ARROW)  &trans   &trans
&kp LC(Y)  &kp MINUS  &aholdtap LS(N4) NUMBER_4  &aholdtap LS(N5) N5        &aholdtap LS(N6) NUMBER_6  &kp LS(EQUAL)  &mkp MCLK  &kp LC(PAGE_DOWN)  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW     &trans   &trans
&trans     &kp DOT    &aholdtap LS(N1) NUMBER_1  &aholdtap LS(N2) NUMBER_2  &aholdtap LS(N3) NUMBER_3  &kp N0         &mkp LCLK  &kp HOME           &kp PAGE_UP       &mkp MB4        &kp PAGE_DOWN       &kp END  &trans
           &trans     &trans                     &trans                     &trans                     &trans                    &mkp LCLK          &mkp MCLK         &mkp RCLK       &trans              &trans
            >;
        };

        FN {
            label = "FN";
            bindings = <
&kp GRAVE  &trans  &kp INS  &trans  &trans      &trans                  &trans             &trans       &trans     &trans         &trans   &trans
&kp LC(N)  &kp F1  &kp F2   &kp F3  &kp LC(R)   &kp LC(T)    &mkp RCLK  &kp LC(PAGE_UP)    &kp LC(UP)   &kp UP     &kp LC(DOWN)   &trans   &trans
&kp LC(Y)  &kp F7  &kp F5   &kp F6  &kp LC(F)   &kp LC(G)    &mkp MCLK  &kp LC(PAGE_DOWN)  &kp LEFT     &kp DOWN   &kp RIGHT      &trans   &trans
&trans     &kp F4  &kp F8   &kp F9  &kp LA(N3)  &kp LA(F11)  &mkp LCLK  &kp HOME           &kp PAGE_UP  &mkp MB4   &kp PAGE_DOWN  &kp END  &trans
           &trans  &trans   &trans  &trans      &trans                  &mkp LCLK          &mkp MCLK    &mkp RCLK  &trans         &trans
            >;
        };

        GAME {
            label = "GAME";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5                &trans     &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp Q   &kp W   &kp E     &kp R      &kp T      &mkp RCLK  &trans     &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp A   &kp S   &kp D     &kp F      &kp G      &mkp MCLK  &trans     &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp B   &kp Z   &kp X     &kp C      &kp V      &mkp LCLK  &trans     &trans  &trans  &trans  &trans  &trans
           &kp N   &kp M   &kp BSPC  &kp SPACE  &kp ENTER             &tog GAME  &trans  &trans  &trans  &trans
            >;
        };

        EXTRA {
            label = "EXTRA";
            bindings = <
&trans  &trans   &trans     &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp B    &kp O      &kp I   &kp U   &kp Y   &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp P    &kp L      &kp K   &kp J   &kp H   &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp DOT  &kp COMMA  &kp M   &kp N   &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
        &trans   &trans     &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER5 {
            label = "LAYER5";
            bindings = <
&trans  &trans  &trans         &trans    &trans       &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp PAGE_DOWN  &kp UP    &kp PAGE_UP  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT       &kp DOWN  &kp RIGHT    &trans  &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans         &trans    &trans       &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans         &trans    &trans       &trans             &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER6 {
            label = "LAYER6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER7 {
            label = "LAYER7";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans
            >;
        };

        LAYER8 {
            label = "LAYER8";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans
            >;
        };

        RESET {
            label = "RESET";
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
             &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
